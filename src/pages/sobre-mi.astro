---
import Layout from '../layouts/Layout.astro';
import Badge from '../components/Badge.astro';

const skills = [
  {
    category: "Lenguajes",
    items: ["Dart", "Python", "JavaScript (ES6+)", "TypeScript", "SQL", "Java"]
  },
  {
    category: "Desarrollo Móvil (Especialidad)",
    items: ["Flutter", "BLoC / Cubit", "Clean Architecture", "Firebase"]
  },
  {
    category: "Frameworks & Web",
    items: ["Angular", "HTML5", "CSS3", "Spring Boot", "APIs REST"]
  },
  {
    category: "Herramientas & Otros",
    items: ["Git", "GitHub", "Docker", "Postman", "Principios SOLID", "Scrum"]
  }
];

const education = [
  {
    date: "2025",
    title: "Grado Superior de Desarrollo de Aplicaciones Multiplataforma",
    platform: "Salesianos de Córdoba",
    description: ""
  },
  {
    date: "2026",
    title: "Universidad Python - Cero a Experto",
    platform: "Udemy",
    description: "Aprendí a crear aplicaciones reales con Python, Django, Flask, Backend con Django REST, Flask REST, FastAPI, Front End con Angular y React, Flet (Flutter + Python), PySide, Tkinter, SqlAlchemy",
    certificate: "https://www.udemy.com/certificate/UC-3997fcab-b7dd-4f6c-bedd-f85eefec5164/"
  },
  {
    date: "2026",
    title: "Universidad Desarrollo Web - FrontEnd Web Developer!",
    platform: "Udemy",
    description: "Aprendí a crear aplicaciones Web desde cero con HTML, CSS y Javascript",
    certificate: "https://www.udemy.com/certificate/UC-ecfa7d0e-4804-45f1-9563-2464b5705f6c/"
  },
  {
    date: "2026",
    title: "Universidad Angular - De Cero a Experto",
    platform: "Udemy",
    description: "Aprendí a desarrollar aplicaciones web modernas, complejas, con capacidad de respuesta y escalables con Angular",
    certificate: "https://www.udemy.com/certificate/UC-ac855550-4df9-42fd-b532-0fd1a17f6c33/"
  }
]
---

<Layout title="Sobre mí">
    <div class="container">
        <h1>Sobre mí 👨‍💻</h1>
        
        <div class="split">
            <div class="text">
                <section>
                    <h2>¿Quién soy?</h2>
                    <p>
                        Un desarrollador multiplataforma con el foco puesto en la calidad del software. Mi experiencia se centra en Flutter y Angular, con un fuerte interés por el desarrollo móvil y el backend con Python y Java/Spring Boot. En mis últimas prácticas, no solo aprendí a programar apps, sino a trabajar en entornos profesionales con Git, APIs REST y metodologías Agile.
                    </p>
                    <p>
                        
                    </p>
                </section>

                <section>
                    <h2>¿Qué hago cuando no estoy programando?</h2>
                    <p>
                        Intento descansar de todo lo relacionado con las tecnologías, me gusta salir a la calle correr, al gimnasio, pasar el rato con amigos, etc. Soy un apasionado del fútbol, durante una gran parte de mi vida jugando y ahora viéndolo. También he descubierto hace poco el mundo del buceo y siempre que puedo intento organizar una escapada para hacer unas inmersiones.
                    </p>
                </section>
            </div>
        </div>
        <section class="skills-section">
            <h2>🛠️ Mi Stack Tecnológico</h2>
            <p class="skills-intro">Estas son las tecnologías que puedo utilizar:</p>
            
            <div class="skills-grid">
                {skills.map((group) => (
                    <div class="skill-card">
                        <h3>{group.category}</h3>
                        <div class="badges-container">
                            <!-- Recorremos los items de cada categoría -->
                            {group.items.map((item) => (
                                <Badge>{item}</Badge>
                            ))}
                        </div>
                    </div>
                ))}
            </div>
        </section>
        <section class="education-section">
            <h2>🎓 Formación Continua</h2>
            
            <div class="timeline">
                {education.map((item) => (
                    <div class="timeline-item">
                        <div class="timeline-marker"></div>
                        <div class="timeline-content">
                            <span class="timeline-date">{item.date}</span>
                            <h3 class="timeline-title">{item.title}</h3>
                            <span class="timeline-platform">{item.platform}</span>
                            <p class="timeline-desc">{item.description}</p>
                            
                            <!-- NUEVO: Botón de certificado condicional -->
                            {item.certificate && (
                                <a href={item.certificate} target="_blank" rel="noopener noreferrer" class="btn-cert">
                                    📄 Ver certificado
                                </a>
                            )}
                        </div>
                    </div>
                ))}
            </div>
        </section>
    </div>
</Layout>

<style>
    h1 { font-size: 3rem; margin-bottom: 2rem; }
    h2 { color: #4f39fa; margin-top: 2rem; }
    p { line-height: 1.6; color: #d1d1d1; margin-bottom: 1rem; }
    
    .split {
        display: flex;
        gap: 3rem;
        align-items: flex-start;
    }
    .text { flex: 2; }
    .image-container { flex: 1; }
    
    .about-img {
        width: 100%;
        border-radius: 12px;
        transform: rotate(3deg);
        border: 2px solid #444;
    }

    @media (max-width: 768px) {
        .split { flex-direction: column-reverse; }
        .about-img { transform: rotate(0); width: 200px; margin: 0 auto; display: block; }
    }

    .skills-section {
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid #333; /* Una línea separadora sutil */
    }

    .skills-intro {
        color: #aaa;
        margin-bottom: 2rem;
    }

    .skills-grid {
        display: grid;
        /* Esto crea columnas automáticas. Si cabe una, pone una. Si caben tres, pone tres. */
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
    }

    .skill-card {
        background: #23262d;
        padding: 1.5rem;
        border-radius: 12px;
        border: 1px solid #333;
        transition: transform 0.2s;
    }

    .skill-card:hover {
        border-color: #555;
        transform: translateY(-5px); /* Pequeño salto al pasar el ratón */
    }

    .skill-card h3 {
        margin-top: 0;
        margin-bottom: 1rem;
        color: #4f39fa; /* Color morado para los títulos */
        font-size: 1.2rem;
    }

    .badges-container {
        display: flex;
        flex-wrap: wrap; /* Permite que los badges bajen de línea si no caben */
        gap: 0.5rem; /* Espacio entre badges */
    }

    .education-section {
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid #333;
        margin-bottom: 4rem; /* Un poco de aire al final */
    }

    .timeline {
        position: relative;
        margin-top: 2rem;
        padding-left: 1rem; /* Espacio para la línea */
    }

    /* La línea vertical gris */
    .timeline::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 2px;
        background: #333;
    }

    .timeline-item {
        position: relative;
        padding-left: 2rem; /* Espacio entre la línea y el texto */
        padding-bottom: 2.5rem; /* Espacio entre un item y otro */
    }

    /* El puntito redondo en la línea */
    .timeline-marker {
        position: absolute;
        left: -5px; /* Para centrarlo en la línea de 2px */
        top: 0;
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: #4f39fa; /* Tu color principal */
        border: 2px solid #13151a; /* Borde oscuro para separarlo de la línea */
        box-shadow: 0 0 10px rgba(79, 57, 250, 0.5); /* Brillo */
    }

    .timeline-date {
        font-size: 0.9rem;
        color: #4f39fa;
        font-weight: bold;
        display: block;
        margin-bottom: 0.5rem;
    }

    .timeline-title {
        font-size: 1.2rem;
        margin: 0;
        color: white;
    }

    .timeline-platform {
        font-size: 0.9rem;
        color: #888;
        font-style: italic;
        display: block;
        margin-bottom: 0.5rem;
    }

    .timeline-desc {
        color: #ccc;
        margin: 0;
        line-height: 1.5;
        font-size: 0.95rem;
    }

    /* Estilo del botón de Certificado */
    .btn-cert {
        display: inline-block;
        margin-top: 1rem;
        padding: 0.4rem 0.8rem;
        background: #1a1a1a;
        border: 1px solid #444;
        border-radius: 6px;
        color: #a6d1ff; /* Un azul claro */
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 500;
        transition: all 0.2s;
    }
    
    .btn-cert:hover {
        background: #4f39fa; /* Tu color principal */
        color: white;
        border-color: #4f39fa;
        transform: translateY(-2px); /* Pequeño saltito */
    }
</style>