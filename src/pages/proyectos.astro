---
import Layout from '../layouts/Layout.astro';
import Card from '../components/Card.astro';

const projects = [
    {
    title: "Mi Portfolio Personal",
    description: "La web que estás viendo ahora mismo. Desarrollada con Astro para asegurar la máxima velocidad (100/100 en Lighthouse) y CSS moderno. Totalmente responsive y accesible.",
    link: "https://github.com/CarlosJavMerino/mi-portfolio.git"
  },
  {
    title: "Abyss",
    description: "Abyss es una aplicación completa para buceadores desarrollada en Flutter. Permite registrar inmersiones, gestionar el equipo de buceo y consultar las condiciones meteorológicas en tiempo real.",
    link: "https://github.com/CarlosJavMerino/AquaLog.git"
  },
  {
    title: "Catálogo de películas",
    description: "Una aplicación de escritorio interactiva inspirada en la interfaz y experiencia de usuario de Netflix, desarrollada en Python utilizando Tkinter para la interfaz gráfica y MySQL para la persistencia de datos.",
    link: "https://github.com/CarlosJavMerino/Catalogo_peliculas"
  }
];
---

<Layout title="Mis Proyectos">
    <section>
        <h1>Mis Trabajos 💻</h1>
        <p class="intro">
            Aquí detallo los proyectos en los que he trabajado, desde experimentos personales hasta aplicaciones completas.
        </p>
        
        <div class="grid">
            {projects.map((project) => (
                <Card 
                    title={project.title} 
                    body={project.description} 
                    href={project.link} 
                />
            ))}
        </div>
    </section>
</Layout>

<style>
    h1 { font-size: 3rem; margin-bottom: 0.5rem; }
    .intro { margin-bottom: 3rem; color: #ccc; max-width: 600px; }
    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 2rem;
    }
</style>